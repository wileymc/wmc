<glyph-field aria-label="Interactive animated character sculpture" role="img">
  <canvas></canvas>
</glyph-field>

<style>
  glyph-field { display: block; position: absolute; inset: 0; cursor: crosshair; touch-action: none; }
  canvas { display: block; width: 100%; height: 100%; }
</style>

<script>
  type Point = [number, number, number];
  type Cell = { char: string; tone: number; alpha: number; back: boolean };
  const LOOP_SECONDS = 64;
  const GLYPHS = ['·', ':', '∴', '∷', '+', '×', '≋', '⊹', '⋰', '∶', '/', '⋮'];
  const COLORS = [[125, 207, 240], [172, 148, 248], [238, 176, 137], [130, 219, 200], [125, 207, 240]];
  const PALETTE = Array.from({ length: 256 }, (_, i) => {
    const position = i / 255 * 4;
    const tone = Math.min(3, Math.floor(position));
    const blend = position - tone;
    return `rgb(${COLORS[tone].map((channel, j) => Math.round(channel + (COLORS[tone + 1][j] - channel) * blend)).join(',')})`;
  });

  class GlyphField extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      const canvas = this.querySelector('canvas')!;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const ink = document.createElement('canvas');
      const pen = ink.getContext('2d')!;
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      let width = 0, height = 0, cols = 0, rows = 0, dpr = 1;
      let time = 0, request = 0, last = 0, held = 0, targetHeld = 0;
      let mouseX = -1000, mouseY = -1000, turn = 0, tilt = 0, targetTurn = 0, targetTilt = 0;
      let rippleAge = 10, rippleX = 0, rippleY = 0;
      const rotate = ([x, y, z]: Point, a: number, b: number): Point => {
        const rx = x * Math.cos(a) - y * Math.sin(a);
        const ry = x * Math.sin(a) + y * Math.cos(a);
        return [rx, ry * Math.cos(b) - z * Math.sin(b), ry * Math.sin(b) + z * Math.cos(b)];
      };
      const paint = () => {
        if (!width || !height) return;
        const depth = new Float32Array(cols * rows).fill(-Infinity);
        const cells: (Cell | undefined)[] = new Array(cols * rows);
        const phase = (time % LOOP_SECONDS) / LOOP_SECONDS * Math.PI * 2;
        const spin = phase + turn;
        const angle = 0.48 + Math.sin(phase * 2) * 0.2 + tilt;
        const scale = Math.min(width / 5.9, height / 5.4) * (1 + held * 0.16);
        const project = (p: Point, u: number, v: number, sample: number, strand: number) => {
          const [x, y, z] = rotate(p, spin, angle);
          const perspective = 5 / (5 - z * 0.27);
          let px = width / 2 + x * scale * perspective;
          let py = height / 2 + y * scale * perspective;
          const dx = px - mouseX, dy = py - mouseY;
          const distance = Math.hypot(dx, dy);
          const force = Math.exp(-distance * distance / 24000) * (22 + held * 32);
          if (distance > 0.1) { px += dx / distance * force; py += dy / distance * force; }
          if (rippleAge < 2.5) {
            const rx = px - rippleX, ry = py - rippleY, radius = Math.hypot(rx, ry);
            const wave = Math.exp(-Math.pow((radius - rippleAge * 240) / 65, 2)) * (1 - rippleAge / 2.5) * 26;
            if (radius > 0.1) { px += rx / radius * wave; py += ry / radius * wave; }
          }
          const col = Math.round(px / width * cols), row = Math.round(py / height * rows);
          if (col < 0 || col >= cols || row < 0 || row >= rows) return;
          const index = row * cols + col;
          if (z < depth[index]) return;
          depth[index] = z;
          const light = Math.max(0, Math.min(1, (z + 2.5) / 5));
          const edge = Math.abs(v) > 0.42;
          cells[index] = {
            char: strand ? (sample % 4 ? '·' : '⊹') : edge ? (light > 0.6 ? '⊹' : '·') : GLYPHS[(sample * 7 + Math.round(v * 100) + 100) % GLYPHS.length],
            tone: Math.floor((Math.sin(u * 2 + phase + strand * 1.8) + 1) * 127.5),
            alpha: (0.3 + light * 0.68) * (strand ? 0.56 : edge ? 0.72 : 1),
            back: z < -0.35,
          };
        };
        // The broad character ribbon and two fine counterwoven filaments all
        // share a periodic phase, so the sculpture never reaches an end frame.
        for (let i = 0; i < 680; i++) {
          const u = i / 680 * Math.PI * 2;
          const wave = Math.sin(u * 3 + phase * 3);
          for (let j = 0; j < 19; j++) {
            const v = j / 18 - 0.5;
            const radius = 1.65 + 0.57 * Math.cos(3 * u + phase) + v * (0.5 + held * 0.38);
            project([radius * Math.cos(u * 2), radius * Math.sin(u * 2), 0.64 * Math.sin(u * 3) + v * (0.75 + wave * 0.25)], u, v, i + j * 3, 0);
          }
          for (let strand = 1; strand <= 2; strand++) {
            const offset = strand * Math.PI;
            const radius = 2.25 + 0.16 * Math.sin(u * 5 + phase * 2 + offset);
            project([radius * Math.cos(u + offset), radius * Math.sin(u + offset), 0.85 * Math.sin(u * 3 - phase * 2 + offset)], u, 0, i, strand);
          }
        }
        pen.font = `500 ${Math.max(9, Math.min(13, width / cols * 1.65))}px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace`;
        pen.textAlign = 'center'; pen.textBaseline = 'middle';
        ctx.clearRect(0, 0, width, height);
        const draw = (back: boolean) => {
          pen.clearRect(0, 0, width, height);
          for (let index = 0; index < cells.length; index++) {
            const cell = cells[index];
            if (!cell || cell.back !== back) continue;
            pen.fillStyle = PALETTE[cell.tone]; pen.globalAlpha = cell.alpha;
            pen.fillText(cell.char, (index % cols + 0.5) * width / cols, (Math.floor(index / cols) + 0.5) * height / rows);
          }
        };
        draw(true);
        ctx.filter = 'blur(1px)'; ctx.globalAlpha = 0.8;
        ctx.drawImage(ink, 0, 0, width, height);
        draw(false);
        ctx.filter = 'blur(6px)'; ctx.globalAlpha = 0.4;
        ctx.drawImage(ink, 0, 0, width, height);
        ctx.filter = 'none'; ctx.globalAlpha = 1;
        ctx.drawImage(ink, 0, 0, width, height);
      };
      const resize = () => {
        const rect = this.getBoundingClientRect(); width = rect.width; height = rect.height;
        cols = Math.max(60, Math.min(260, Math.round(width / 7)));
        rows = Math.max(45, Math.min(140, Math.round(height / 11)));
        dpr = Math.min(devicePixelRatio || 1, 2);
        for (const target of [canvas, ink]) { target.width = Math.round(width * dpr); target.height = Math.round(height * dpr); }
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0); pen.setTransform(dpr, 0, 0, dpr, 0, 0);
        paint();
      };
      const move = (event: PointerEvent) => {
        const rect = this.getBoundingClientRect();
        mouseX = event.clientX - rect.left; mouseY = event.clientY - rect.top;
        targetTurn = (mouseX / width - 0.5) * 0.85;
        targetTilt = (mouseY / height - 0.5) * 0.45;
      };
      const down = (event: PointerEvent) => { move(event); targetHeld = 1; rippleAge = 0; rippleX = mouseX; rippleY = mouseY; };
      const up = () => { targetHeld = 0; };
      const leave = () => { mouseX = -1000; mouseY = -1000; targetTurn = 0; targetTilt = 0; targetHeld = 0; };
      const tick = (now: number) => {
        if (now - last >= 1000 / 30) {
          const dt = Math.min((now - (last || now)) / 1000, 0.06); last = now;
          if (document.visibilityState === 'visible') {
            const ease = 1 - Math.exp(-dt * 4);
            held += (targetHeld - held) * ease; turn += (targetTurn - turn) * ease; tilt += (targetTilt - tilt) * ease;
            if (!motion.matches) { time = (time + dt) % LOOP_SECONDS; rippleAge += dt; }
            else rippleAge = 10;
            paint();
          }
        }
        request = requestAnimationFrame(tick);
      };
      const observer = new ResizeObserver(resize); observer.observe(this);
      this.addEventListener('pointermove', move); this.addEventListener('pointerdown', down);
      this.addEventListener('pointerleave', leave); this.addEventListener('pointercancel', leave);
      window.addEventListener('pointerup', up);
      request = requestAnimationFrame(tick);
      this.cleanup = () => {
        cancelAnimationFrame(request); observer.disconnect();
        this.removeEventListener('pointermove', move); this.removeEventListener('pointerdown', down);
        this.removeEventListener('pointerleave', leave); this.removeEventListener('pointercancel', leave);
        window.removeEventListener('pointerup', up);
      };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('glyph-field')) customElements.define('glyph-field', GlyphField);
</script>
