---
import Layout from '../layouts/Layout.astro';
import socialsJson from "../constants/socials.json"
import { RiArrowRightUpLine } from "react-icons/ri";
import Card from "../components/react/Card";
import FluidMark from "../components/FluidMark.astro";
import { FaLinkedin, FaGithub, FaTwitter } from "react-icons/fa";
import { MdEmail } from "react-icons/md";
import { SiInstagram, SiSpotify } from "react-icons/si";

const socials = socialsJson;

const iconComponents = {
  linkedin: FaLinkedin,
  github: FaGithub,
  twitter: FaTwitter,
  email: MdEmail,
  instagram: SiInstagram,
  spotify: SiSpotify,
};
---

<Layout>
	<h1 class="text-[1.75rem] font-serif tracking-tight text-primary  font-bold">
		Wiley McKay Conte
	</h1>

	<p class="pt-4 text-sm font-light">
		I’m a solutions engineer at <a href="https://www.fivetran.com" class="underline decoration-dotted hover:text-primary">Fivetran</a> + <a href="https://www.getdbt.com" class="underline decoration-dotted hover:text-primary">dbt Labs</a>, cofounder of <a href="https://populist.us" class="underline decoration-dotted hover:text-primary">Populist</a>, and founder of <a href="https://tryida.com" class="underline decoration-dotted hover:text-primary">Intelligence and Design Applied (IDA)</a>. I build and sell software, work with data, and help ambitious teams put AI to use to accelerate their businesses.
	</p>

	<div class="w-fit grid grid-cols-3 gap-2 pt-4 tracking-tight md:flex md:flex-row md:items-start">
		{
			socials.map((social) => {
			const IconComponent = iconComponents[social.icon.toLowerCase()];

			return  (
				<a
					href={social.url}
					target={social.target}
					rel={social.target === "_blank" ? "noopener noreferrer" : undefined}
					class="group flex items-center underline-offset-4 transition duration-150 ease-in-out md:hover:text-primary md:hover:underline">
					  {IconComponent ? <IconComponent size={14} className="mr-1.5" /> : <span>{social.name}</span>}
					<span class="text-sm">{social.name}</span>
					<RiArrowRightUpLine className="opacity-0 transition-opacity duration-150 md:group-hover:opacity-100" />
				</a>
			)
		})
		}
	</div>

	<section class="pt-8">
	<h2 class="font-medium tracking-tight text-title dark:text-darkTitle">Explore</h2>
	<Card project={{ id: 1, title: "IDA", description: "Custom software and AI implementation", link: "https://tryida.com", tags: ["llms"] }} />
	<Card project={{ id: 1, title: "Populist", description: "Civic engagement as a service", link: "https://populist.us", tags: ["open source", "llms"] }} />
	<Card project={{ id: 2, title: "Uptime", description: "Real time endpoint monitoring", link: "https://github.com/wileymc/uptime", tags: ["open source"] }} />
	</section>
	<FluidMark />
	
</Layout>
